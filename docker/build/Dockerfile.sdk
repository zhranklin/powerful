# How to build base image:
# ./build-base-img.sh
FROM harbor.cloud.netease.com/qztest/powerful-jdk-all:v0.10.0-jdk-all
ENV OPERATOR=/usr/local/bin/helm-operator \
    USER_UID=1001 \
    USER_NAME=helm \
    HOME=/opt/helm
ARG TARGETARCH
COPY build/operator-sdk-dev-$TARGETARCH-linux-gnu ${OPERATOR}
